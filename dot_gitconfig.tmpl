[user]
	email = dennis@tychsen.me
	name = dentych
{{- if eq .hosttype "desktop" "laptop" }}
[url "git@github.com:"]
	insteadOf = https://github.com/
{{- end }}
[push]
	default = current
	autoSetupRemote = true
[init]
	defaultBranch = main

[diff]
    tool = zed
[difftool "zed"]
    cmd = zed --wait --diff $LOCAL $REMOTE

[core]
	editor = hx

[includeIf "gitdir:~/code/understory/"]
	path = ~/.gitconfig-understory

[includeIf "gitdir:~/understory/"]
	path = ~/.gitconfig-understory
{{- with lookPath "gh" }}

[credential "https://github.com"]
	helper =
	helper = !{{ . }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ . }} auth git-credential
{{- end }}

# Mirrors ~/.config/alacritty/alacritty.toml
# Reload with ctrl+shift+f5 (cmd+ctrl+, on macOS); kitty has no auto-reload

# Written by the `opacity` fish function
globinclude opacity.conf
dynamic_background_opacity yes

# Lets `opacity` change live windows via `kitten @` (also works inside tmux/zellij)
allow_remote_control socket-only
listen_on unix:@kitty

term xterm-256color
{{- if eq .chezmoi.os "darwin" }}
# Match Alacritty: force a valid locale so perl/locale doesn't warn over SSH
env LANG=en_US.UTF-8
env LC_CTYPE=en_US.UTF-8
{{- end }}

# Window
hide_window_decorations yes
window_padding_width 8 8
macos_option_as_alt yes
confirm_os_window_close 0
tab_bar_style hidden

# Font
font_family JetBrainsMono Nerd Font
bold_font auto
italic_font auto
bold_italic_font auto
{{- if eq .chezmoi.os "linux" }}
font_size 12.0
{{- else }}
font_size 14.0
{{- end }}

# Cursor
cursor_shape beam
cursor_blink_interval 0
# Keep shell integration from overriding the cursor shape
shell_integration no-cursor

# Bell
enable_audio_bell no
command_on_bell {{ .chezmoi.homeDir }}/.local/bin/notify-bell.sh

# Selection
copy_on_select clipboard

# Keyboard (ctrl+shift+c/v and cmd+c/v are kitty defaults)
# Shift+Enter for newline (useful in Claude Code)
map shift+enter send_text all \n


[general]
live_config_reload = true
import = ["~/.config/alacritty/opacity.toml"]

[env]
TERM = "xterm-256color"
{{- if eq .chezmoi.os "darwin" }}
# Alacritty sets LC_CTYPE="UTF-8" (an invalid locale name) when macOS' system
# locale fails validation, which trips perl/locale warnings over SSH
LANG = "en_US.UTF-8"
LC_CTYPE = "en_US.UTF-8"
{{- end }}

[window]
decorations = "None"
blur = false
#opacity = 0.60
padding = { x = 16, y = 8 }
option_as_alt = "Both"
startup_mode = "maximized"

[font]
{{- if eq .chezmoi.os "linux" }}
size = 12.0
{{ else }}
size = 14.0
{{- end }}
normal = { family = "JetBrainsMono Nerd Font" }
bold = { family = "JetBrainsMono Nerd Font" }

[cursor]
style = { shape = "Beam", blinking = "Off" }
vi_mode_style = { shape = "Beam", blinking = "Off" }

[bell]
command = { program = "{{ .chezmoi.homeDir }}/.local/bin/notify-bell.sh" }

[selection]
save_to_clipboard = true

[keyboard]
bindings = [
    # macOS clipboard
    { key = "V", mods = "Super", action = "Paste" },
    { key = "C", mods = "Super", action = "Copy" },
    # Linux clipboard
    { key = "V", mods = "Control|Shift", action = "Paste" },
    { key = "C", mods = "Control|Shift", action = "Copy" },
    # Shift+Enter for newline (useful in Claude Code)
    { key = "Return", mods = "Shift", chars = "\n" },
]
